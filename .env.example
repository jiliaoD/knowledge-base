# ==========================================================================
# 产品手册智能问答 —— 环境变量模板
#
# 用法：复制成 .env 再填真实值
#     Linux/Mac:  cp .env.example .env
#     Windows:    Copy-Item .env.example .env
#
# 注意：.env 已被 .gitignore 忽略，密钥不会上传到 GitHub；
#       本文件只放占位符，千万不要把真实 Key 提交上来。
# 标注【必填】的配不上，对应链路会直接报错。
# ==========================================================================

# ==================== 1. 对话大模型（OpenAI 兼容接口） ====================
# 【必填】模型网关地址，这里用阿里云百炼 DashScope 的 OpenAI 兼容模式
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 【必填】API Key（sk- 开头），在 https://bailian.console.aliyun.com 申请
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 【必填】主对话模型（生成最终答案）
LLM_DEFAULT_MODEL=qwen-flash
# 采样温度：知识库问答建议 0.1~0.3，越低越稳定、越不容易编
LLM_DEFAULT_TEMPERATURE=0.1
# 【必填】商品名识别用的模型（要求能稳定输出 JSON）
ITEM_MODEL=qwen-flash
# 【必填】图片摘要用的多模态模型（导入链路给手册插图生成描述）
VL_MODEL=qwen3-vl-flash

# ==================== 2. 重排序模型（DashScope TextReRank） ====================
# 【必填】重排序用的 Key（可以和上面同一把，也可单独申请）
OPENAI_API_KEY_DASHSCOPE=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 重排序模型名
TEXT_RERANK_MODEL=qwen3-rerank
# 重排序指令：告诉模型"按能不能解答这个问题来打分"
TEXT_RERANK_INSTRUCT=针对给定的查询，检索能够解答该查询的相关段落

# ==================== 3. 联网搜索（百炼 MCP 服务） ====================
# 百炼 MCP 联网搜索服务地址（Streamable HTTP）
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse
# 调用 MCP 的 Key。留空则按 BAILIAN_API_KEY -> DASHSCOPE_API_KEY -> OPENAI_API_KEY 依次回退
BAILIAN_API_KEY=

# ==================== 4. PDF 结构化解析（MinerU） ====================
# MinerU 接口地址（一般不用改）
MINERU_BASE_URL=https://mineru.net/api/v4
# 【必填】MinerU API Token，在 https://mineru.net 的 API 页面申请
MINERU_API_TOKEN=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 模型来源：modelscope / huggingface
MINERU_MODEL_SOURCE=modelscope

# ==================== 5. 向量数据库（Milvus） ====================
# 【必填】Milvus 地址。集合不存在时导入流程会自动创建，无需手工建表
MILVUS_URL=http://192.168.100.100:19530
# 知识库切片集合名
CHUNKS_COLLECTION=kb_chunks
# 标准商品名集合名
ITEM_NAME_COLLECTION=kb_item_names
# 以下两个是历史遗留配置，当前代码未读取，保留仅作参考
# MILVUS_METRIC_TYPE=COSINE
# MILVUS_MIN_COSINE_SCORE=0.75

# ==================== 6. 会话历史（MongoDB） ====================
# 【必填】MongoDB 地址。服务启动时会连库并建索引，连不上服务起不来
MONGO_URL=mongodb://192.168.100.100:27017
# 数据库名
MONGO_DB_NAME=kb001

# ==================== 7. 对象存储（MinIO） ====================
# 【必填】MinIO 地址（注意不带 http://）
MINIO_ENDPOINT=192.168.100.100:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# 存储桶名，不存在会自动创建
MINIO_BUCKET_NAME=knowledge-base
# 手册图片在桶内的目录前缀（答案里的图片地址就是这个目录下的对象）
MINIO_IMAGE_DIR=upload_images

# ==================== 8. 本地向量模型（BGE-M3） ====================
# 模型下载到本地后填绝对路径；也可以直接填 ModelScope 上的模型名（会联网自动下载）
BGE_M3_PATH=D:/ai_models/modelscope_cache/models/BAAI/bge-m3
# 运行设备：有 N 卡填 cuda:0，没有就填 cpu（会很慢）
BGE_DEVICE=cuda:0
# 是否使用半精度
BGE_FP16=True
# 模型缓存目录
MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
HF_HOME=D:/ai_models/huggingface_cache
# 1 = 只用本地缓存，不联网检查更新（离线跑更稳）
MODELSCOPE_OFFLINE=1
# 以下三个是预留配置：当前重排序走 DashScope 的 HTTP 接口，本地重排模型未启用
# BGE_RERANKER_LARGE=D:/ai_models/modelscope_cache/models/BAAI/bge-reranker-large
# BGE_RERANKER_DEVICE=cuda:0
# BGE_RERANKER_FP16=1

# ==================== 9. 导入与运行参数 ====================
# 上传文件与解析中间产物的根目录。
# 导入服务优先读 DATA_BASED_ROOT_DIR，其次 MD_ROOT_DIR，最后回落到 ./doc
MD_ROOT_DIR=./temp-files/
# DATA_BASED_ROOT_DIR=./temp-files/
# 图片摘要（多模态模型）每分钟最大请求数，用来避免触发服务端限流
VL_REQUESTS_PER_MINUTE=60
# 日志级别：INFO（默认）/ DEBUG（排查问题用，输出非常多）
LOG_LEVEL=INFO
